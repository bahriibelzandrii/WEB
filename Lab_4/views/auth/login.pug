extends ../layout

block title
  title Вхід — Сервіс ремонту техніки

block content
  .auth-card
    h1 Вхід у систему
    if loggedout === "1" || (typeof loggedout !== "undefined" && loggedout)
      .alert.alert-ok Ви вийшли з системи
    include ../partials/flash
    form(method="post", action="/login")
      input(type="hidden", name="next", value=(next || "/"))
      .field
        label Email
        input(type="email", name="email", value=((values && values.email) || ""), placeholder="admin@service.ua")
      .field
        label Пароль
        input(type="password", name="password")
      .form-actions
        button.btn.btn-primary(type="submit") Увійти
        a.btn(href="/register") Зареєструватись
  .quick-login
    h2 Швидкий вхід
    p.lead 1 клік — автоматичне заповнення та вхід під демо-акаунтом
    .quick-grid
      button(type="button").quick-btn(data-email="client@service.ua") Клієнт
      button(type="button").quick-btn(data-email="tech1@service.ua") Майстер 1
      button(type="button").quick-btn(data-email="tech2@service.ua") Майстер 2
      button(type="button").quick-btn(data-email="visitor@service.ua") Відвідувач
      button(type="button").quick-btn(data-email="admin@service.ua") Адмін
    script.
      document.querySelectorAll(".quick-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var form = document.querySelector('form[action="/login"]');
          form.email.value = btn.dataset.email;
          form.password.value = "Secret123";
          form.submit();
        });
      });
