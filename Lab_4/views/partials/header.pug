header.site-header
  .container.nav
    a.brand(href="/") Сервіс ремонту техніки
    a(href="/" class=(nav === "home" ? "active" : "")) Головна
    a(href="/requests" class=(nav === "requests" ? "active" : "")) Заявки
    a(href="/clients" class=(nav === "clients" ? "active" : "")) Клієнти
    a(href="/devices" class=(nav === "devices" ? "active" : "")) Пристрої
    a(href="/works" class=(nav === "works" ? "active" : "")) Роботи
    a(href="/parts" class=(nav === "parts" ? "active" : "")) Запчастини
    .nav-user
      if user
        span.user-chip
          = user.name
          span.role-badge= roleLabel
        a(href="/logout") Вийти
      else
        a(href="/login") Вхід
