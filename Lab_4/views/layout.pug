doctype html
html(lang="uk")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    block title
      title Сервіс ремонту та обслуговування комп'ютерної техніки
    link(rel="stylesheet", href="/css/style.css")
  body
    include partials/header
    main.container
      include partials/flash
      block content
    include partials/footer
    script.
      (function () {
        // D43: після сабміту форми повернутись до її позиції, а не на початок сторінки
        function saveRestore(form) {
          var action = form.getAttribute("action") || form.action;
          var offset = form.getBoundingClientRect().top;
          try {
            sessionStorage.setItem("lab3-restore", JSON.stringify({
              url: location.pathname + location.search,
              action: action,
              offset: offset,
              y: window.pageYOffset || 0,
              t: Date.now()
            }));
          } catch (e) {}
        }
        document.addEventListener("submit", function (e) {
          var form = e.target && e.target.closest ? e.target.closest("form") : null;
          if (form) saveRestore(form);
        });
        var raw = null;
        try { raw = sessionStorage.getItem("lab3-restore"); } catch (e) {}
        if (raw) {
          var m = null;
          try { m = JSON.parse(raw); } catch (e) {}
          if (m && m.url === location.pathname + location.search && Date.now() - m.t < 60000) {
            var f = document.querySelector('form[action="' + m.action + '"]');
            var target;
            if (f) target = f.getBoundingClientRect().top + (window.pageYOffset || 0) - m.offset;
            else target = m.y;
            window.scrollTo(0, Math.max(0, target));
            try { sessionStorage.removeItem("lab3-restore"); } catch (e) {}
          }
        }
      })();
