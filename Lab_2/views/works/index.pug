extends ../layout

block title
  title Каталог робіт — Сервіс ремонту техніки

block content
  .page-head
    h1 Каталог робіт
    p.lead Базові ціни та тривалість робіт

  table.table
    thead
      tr
        th Робота
        th Опис
        th.num Базова ціна
        th.num Години
    tbody
      each w in items
        tr
          td= w.name
          td= w.description || "—"
          td.num= uah(w.basePrice)
          td.num= w.baseHours
      if items.length === 0
        tr
          td(colspan=4).empty Каталог порожній
